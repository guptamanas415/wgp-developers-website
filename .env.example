# GEMINI_API_KEY: Optional if using Gemini API features
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# OFFICIAL GMAIL ORDER NOTIFICATION CONFIGURATION
# To dispatch live emails directly to wgpdevelopers@gmail.com, configure standard Gmail credentials:
GMAIL_USER="wgpdevelopers@gmail.com"
GMAIL_APP_PASSWORD="your-16-character-google-app-password"

# Alternatively, configure custom SMTP server:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="wgpdevelopers@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_SECURE="false"
